<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <title>{{article.title}}</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .article-content { line-height: 1.6; font-size: 1.1rem; color: #cbd5e1; margin-top: 20px; }
        .meta-info { background: rgba(255,255,255,0.05); padding: 15px; border-radius: 8px; margin: 20px 0; border-left: 4px solid var(--accent); }
    </style>
</head>
<body>
<div class="container">
    <header>
        <h1>{{article.title}}</h1>
        <p class="subtitle">Тема: {{article.topic}}</p>
    </header>

    <div class="meta-info">
        <strong>Автор:</strong> {{article.authorName}}<br>
        <strong>Логін:</strong> {{article.login}}<br>
        <strong>Адреса:</strong> {{article.authorAddress}}
    </div>

    <div class="article-content">
        {{article.content}}
    </div>

    {{#if article.illustration}}
        <div style="margin-top: 20px;">
            <img src="{{article.illustration}}" alt="Ілюстрація" style="max-width: 100%; border-radius: 12px; border: 1px solid var(--border);">
        </div>
    {{/if}}

    <div style="margin-top: 40px; display: flex; gap: 15px;">
        <a href="/" class="btn btn-outline">← Повернутися до списку</a>
        <a href="/edit/{{article._id}}" class="btn btn-primary">Редагувати статтю</a>
    </div>
</div>
</body>
</html>
