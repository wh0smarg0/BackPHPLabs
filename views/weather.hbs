<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{city}} — Прогноз погоди</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="container">
    <header>
        <h1>{{city}}</h1>
        <div class="subtitle">Поточний прогноз</div>
    </header>

    <div class="weather-main">
        <img src="https://openweathermap.org/img/wn/{{icon}}@4x.png" class="weather-icon" alt="{{description}}">

        <div class="temp-display">{{temp}}°</div>

        <div class="desc">{{description}}</div>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <span class="stat-label">Вологість</span>
            <span class="stat-value">{{humidity}}%</span>
        </div>
        <div class="stat-card">
            <span class="stat-label">Тиск</span>
            <span class="stat-value">{{pressure}} hPa</span>
        </div>
    </div>

    <a href="/" class="btn-back">← До списку міст</a>
</div>
</body>
</html>
