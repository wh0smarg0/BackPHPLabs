<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Редагувати: {{article.title}}</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="container">
    <header>
        <h1>Редагувати статтю</h1>
        <p class="subtitle">ID запису: <span style="font-family: monospace; color: var(--accent);">{{article._id}}</span></p>
    </header>

    <form action="/articles/{{article._id}}?_method=PUT" method="POST">

        <div class="form-group">
            <label for="authorName">Автор та Логін</label>
            <div style="display: flex; gap: 10px; margin-top: 5px;">
                <input type="text" id="authorName" name="authorName" value="{{article.authorName}}" placeholder="Ім'я автора" required>
                <input type="text" name="login" value="{{article.login}}" placeholder="Обліковий запис">
            </div>
        </div>

        <div class="form-group">
            <label for="topic">Тематика та Заголовок</label>
            <input type="text" id="topic" name="topic" value="{{article.topic}}" placeholder="Тема (наприклад, Програмування)">
            <input type="text" name="title" value="{{article.title}}" placeholder="Заголовок статті" required style="margin-top: 10px;">
        </div>

        <div class="form-group">
            <label for="authorAddress">Адреса автора</label>
            <input type="text" id="authorAddress" name="authorAddress" value="{{article.authorAddress}}" placeholder="Місто, вулиця...">
        </div>

        <div class="form-group">
            <label for="content">Текст статті</label>
            <textarea id="content" name="content" rows="6" placeholder="Введіть основний текст статті тут...">{{article.content}}</textarea>
        </div>

        <div class="form-group">
            <label for="illustration">Шлях до ілюстрації (URL або назва файлу)</label>
            <input type="text" id="illustration" name="illustration" value="{{article.illustration}}" placeholder="image.jpg">
        </div>

        <div style="margin-top: 30px; display: flex; gap: 15px;">
            <button type="submit" class="btn btn-primary">Оновити дані в MongoDB</button>
            <a href="/" class="btn btn-outline">Скасувати зміни</a>
        </div>
    </form>

    <footer style="margin-top: 40px; border-top: 1px solid var(--border); padding-top: 15px; font-size: 0.8rem; color: var(--text-dim);">
        Варіант №9 | Редагування документа в колекції Articles
    </footer>
</div>
</body>
</html>
