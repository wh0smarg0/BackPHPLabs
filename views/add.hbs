<!DOCTYPE html>
<html>
<head>
    <title>Додати статтю</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="container">
    <h1>Додати статтю</h1>
    <p class="subtitle">Заповніть дані для збереження в базу MongoDB</p>

    <form action="/articles" method="POST">
        <div class="form-group">
            <label>Автор та Логін</label>
            <div style="display: flex; gap: 10px;">
                <input type="text" name="authorName" placeholder="Повне ім'я" required>
                <input type="text" name="login" placeholder="Обліковий запис">
            </div>
        </div>

        <div class="form-group">
            <label>Деталі статті</label>
            <input type="text" name="topic" placeholder="Тема (наприклад, Технології)">
            <input type="text" name="title" placeholder="Заголовок статті" required>
        </div>

        <div class="form-group">
            <label>Контент</label>
            <textarea name="content" rows="5" placeholder="Текст статті..."></textarea>
        </div>

        <div style="margin-top: 25px; display: flex; gap: 15px;">
            <button type="submit" class="btn btn-primary">Зберегти в БД</button>
            <a href="/" class="btn btn-outline">Скасувати</a>
        </div>
    </form>
</div>
</body>
</html>
