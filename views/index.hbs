<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="container">
    <header>
        <h1>Архів статей MongoDB & GraphQL</h1>
        <div class="subtitle">Лабораторна робота №6 | Варіант №9 | Сахно Маргарита</div>
    </header>

    <div class="actions" style="margin-bottom: 30px; display: flex; gap: 15px; flex-wrap: wrap;">
        <a href="/add" class="btn btn-primary" style="text-decoration: none;">+ Додати нову статтю</a>
        <a href="/api/articles" target="_blank" class="btn btn-outline" style="text-decoration: none;">Відкрити JSON API</a>
        <a href="/graphql" target="_blank" class="btn btn-outline" style="text-decoration: none; border-color: #e10098; color: #e10098;">Відкрити GraphQL Sandbox</a>
    </div>

    {{#if articles.length}}
        <table>
            <thead>
            <tr>
                <th>Автор</th>
                <th>Заголовок (клік для перегляду)</th>
                <th>Тема</th>
                <th style="text-align: right;">Дії</th>
            </tr>
            </thead>
            <tbody>
            {{#each articles}}
                <tr>
                    <td>
                        <div style="font-weight: 600; color: var(--text-main);">{{this.authorName}}</div>
                        <div style="font-size: 0.75rem; color: var(--text-dim);">{{this.login}}</div>
                    </td>
                    <td>
                        <a href="/articles/{{this._id}}" style="color: var(--accent); text-decoration: none; font-weight: 500; border-bottom: 1px dashed var(--accent);">
                            {{this.title}}
                        </a>
                    </td>
                    <td>
                        <span style="white-space: nowrap; background: rgba(56, 189, 248, 0.1); color: var(--accent); padding: 4px 8px; border-radius: 4px; font-size: 0.8rem;">
                            {{this.topic}}
                        </span>
                    </td>
                    <td style="text-align: right;">
                        <div style="display: flex; gap: 15px; justify-content: flex-end; align-items: center;">
                            <a href="/edit/{{this._id}}" title="Редагувати" style="text-decoration: none; color: var(--text-dim); font-size: 1.2rem;">✎</a>

                            <form action="/articles/{{this._id}}?_method=DELETE" method="POST" style="display: inline;" onsubmit="return confirm('Ви впевнені, що хочете видалити цю статтю?')">
                                <button type="submit" class="btn-delete" style="border: none; background: none; cursor: pointer; font-size: 0.9rem; color: var(--danger);">Видалити</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {{/each}}
            </tbody>
        </table>
    {{else}}
        <div style="text-align: center; padding: 50px; color: var(--text-dim); border: 2px dashed var(--border); border-radius: 12px;">
            <p>У базі даних поки немає жодної статті.</p>
            <a href="/add" style="color: var(--accent);">Створіть першу статтю зараз</a>
        </div>
    {{/if}}
</div>
</body>
</html>
